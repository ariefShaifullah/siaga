  "cards": [
    {
      "dot": "rose",
      "title": "Safety rules in the flow",
      "items": [
        "Call 112 stays in the bottom safe area on every screen",
        "First-aid steps come only from bundled FirstAid.json",
        "The draft is copied or opened in Messages by the user; Siaga never sends or calls",
        "The brief is saved to incident history and indexed in Spotlight before the plan runs"
      ]
    },
    {
      "dot": "cyan",
      "title": "One session, four modes",
      "items": [
        "Chat, triage and action swap instructions and tools in one LanguageModelSession",
        "The handover mode exists but is not used: the handover is built in plain Swift",
        "The action stream is stopped from outside once the draft exists, or after 60 seconds"
      ]
    }
  ]
