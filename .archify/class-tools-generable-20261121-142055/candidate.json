  "cards": [
    {
      "dot": "cyan",
      "title": "Who fills what",
      "items": [
        "The model generates each Arguments value; the app's call(arguments:) runs plain Swift",
        "Every call returns a String the model reads, recorded in SiagaStore",
        "EmergencyBrief is the triage output from respond(generating:)"
      ]
    },
    {
      "dot": "violet",
      "title": "Registered per mode",
      "items": [
        "Action: LookupMedicalProfile, LookupFirstAid, DraftEmergencyMessage, each called at most once",
        "Handover: CreateHandoverTool is registered, but that mode never runs; the app calls SiagaStore.createHandover directly",
        "SpotlightSearchTool was removed on 21 Nov: its on-device asset is unavailable"
      ]
    },
    {
      "dot": "slate",
      "title": "Reading this diagram",
      "items": [
        "Tool requirements come from FoundationModels, not this repo",
        "All four tools hold a SiagaStore; it is shown as a field, not a separate box"
      ]
    }
  ]
